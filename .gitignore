# Dependencies
**/node_modules/

# Build outputs
**/dist/
**/dist-ssr/
**/build/
**/.next/
**/out/

# Logs
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# Local-only files
**/*.local

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Tool caches
**/.vite/
**/.cache/
**/.turbo/
**/coverage/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
**/.idea/
**/*.suo
**/*.ntvs*
**/*.njsproj
**/*.sln
**/*.sw?

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
**/*.tmp
**/*.temp
